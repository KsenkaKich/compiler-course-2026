# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/kichanova_k_FIIT3_lab3_BACKEND%shlibext \
# RUN: -run-pass=inline-recursive %s -o - | FileCheck %s

--- |
  define i32 @factorial(i32 %n) {
  entry:
    %cmp = icmp sgt i32 %n, 1
    br i1 %cmp, label %if.then, label %if.end
  if.then:
    %sub = add i32 %n, -1
    %call = call i32 @factorial(i32 %sub)
    %mul = mul i32 %call, %n
    ret i32 %mul
  if.end:
    ret i32 1
  }

  define i32 @isEven(i32 %n) {
  entry:
    %cmp = icmp eq i32 %n, 0
    br i1 %cmp, label %if.then, label %if.else
  if.then:
    ret i32 1
  if.else:
    %sub = add i32 %n, -1
    %call = call i32 @isEven(i32 %sub)
    ret i32 %call
  }

  define i32 @sum(i32 %n) {
  entry:
    %cmp = icmp sgt i32 %n, 0
    br i1 %cmp, label %if.then, label %if.end
  if.then:
    %sub = add i32 %n, -1
    %call = call i32 @sum(i32 %sub)
    %add = add i32 %call, %n
    ret i32 %add
  if.end:
    ret i32 0
  }

...
---
# CHECK-LABEL: name: factorial
# CHECK: CALL64pcrel32 @factorial
name: factorial
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
  - { id: 3, class: gr32 }
liveins:
  - { reg: '$edi', virtual-reg: '' }
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    CMP32ri %0, 1, implicit-def $eflags
    JCC_1 %bb.1, 15, implicit $eflags
    JMP_1 %bb.2
  bb.1:
    %1:gr32 = ADD32ri %0, -1, implicit-def $eflags
    $edi = COPY %1
    CALL64pcrel32 @factorial, csr_64, implicit $edi, implicit-def $eax
    %2:gr32 = COPY $eax
    %3:gr32 = IMUL32rr %2, %0, implicit-def $eflags
    $eax = COPY %3
    RET64
  bb.2:
    $eax = MOV32ri 1
    RET64

...
---
# CHECK-LABEL: name: isEven
# CHECK: CALL64pcrel32 @isEven
name: isEven
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
liveins:
  - { reg: '$edi', virtual-reg: '' }
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    CMP32ri %0, 0, implicit-def $eflags
    JCC_1 %bb.1, 4, implicit $eflags
    JMP_1 %bb.2
  bb.1:
    $eax = MOV32ri 1
    RET64
  bb.2:
    %1:gr32 = ADD32ri %0, -1, implicit-def $eflags
    $edi = COPY %1
    CALL64pcrel32 @isEven, csr_64, implicit $edi, implicit-def $eax
    $eax = COPY $eax
    RET64

...
---
# CHECK-LABEL: name: sum
# CHECK: CALL64pcrel32 @sum
name: sum
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
liveins:
  - { reg: '$edi', virtual-reg: '' }
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    CMP32ri %0, 0, implicit-def $eflags
    JCC_1 %bb.1, 15, implicit $eflags
    JMP_1 %bb.2
  bb.1:
    %1:gr32 = ADD32ri %0, -1, implicit-def $eflags
    $edi = COPY %1
    CALL64pcrel32 @sum, csr_64, implicit $edi, implicit-def $eax
    %2:gr32 = COPY $eax
    %3:gr32 = ADD32rr %2, %0, implicit-def $eflags
    $eax = COPY %3
    RET64
  bb.2:
    $eax = MOV32ri 0
    RET64